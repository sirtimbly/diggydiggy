{
  "name": "diggydiggy",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "description": "A local-first project excavation board with embedded Dolt and Git synchronization",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run test:unit && pnpm run typecheck && pnpm run test:worker && pnpm run build",
    "dev:worker": "wrangler dev --port 8787",
    "test:unit": "node --test *.test.js",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --env-file .env.example",
    "cf:whoami": "wrangler whoami",
    "cf:login": "wrangler login --device",
    "deploy:check": "pnpm run build && wrangler deploy --dry-run",
    "deploy:staging": "pnpm run check && CLOUDFLARE_ENV=staging vite build && wrangler deploy --env staging",
    "deploy": "pnpm run check && wrangler deploy",
    "build:local": "vite build --config vite.local.config.js",
    "local:build": "pnpm run build:local && sh scripts/local-go.sh build -o ../bin/diggy ./cmd/diggy",
    "local:start": "pnpm run local:build && ./bin/diggy",
    "local:install": "pnpm run local:build && node scripts/install-local.mjs",
    "test:local": "pnpm run build:local && sh scripts/local-go.sh test ./...",
    "postinstall": "node npm/install.mjs",
    "test:package": "node --test npm/*.test.mjs",
    "release:binary": "node scripts/build-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "prepublishOnly": "node npm/validate.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT",
  "bin": {
    "diggy": "npm/diggy.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "npm/diggy.mjs",
    "npm/install.mjs",
    "npm/native.mjs",
    "npm/validate.mjs",
    "npm/release.json",
    "npm/licenses/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "local/licenses/",
    "assets/OFL-*.txt"
  ],
  "publishConfig": {
    "access": "public"
  }
}
