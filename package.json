{
  "name": "diggy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pixel-art project excavation prototype",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run test:unit && npm run typecheck && npm run test:worker && npm run build",
    "dev:worker": "wrangler dev --port 8787",
    "test:unit": "node --test *.test.js",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --env-file .env.example",
    "cf:whoami": "wrangler whoami",
    "cf:login": "wrangler login --device",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:staging": "npm run check && CLOUDFLARE_ENV=staging vite build && wrangler deploy --env staging",
    "deploy": "npm run check && wrangler deploy",
    "build:local": "vite build --config vite.local.config.js",
    "local:build": "npm run build:local && sh scripts/local-go.sh build -o ../bin/diggy ./cmd/diggy",
    "local:start": "npm run local:build && ./bin/diggy",
    "test:local": "npm run build:local && sh scripts/local-go.sh test ./..."
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0"
  },
  "license": "MIT"
}
